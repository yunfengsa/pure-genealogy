# 复制为 .env（Compose）或 .env.local（本地开发）。配置在应用启动时读取。
# Supabase API 地址必须使用 HTTP(S)，不能使用数据库连接串。
# 留空即同源部署：API 与页面同一个域名，浏览器直接请求 /auth/v1 与 /rest/v1。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# 仅允许 publishable key 或旧版 anon JWT，绝不能填写 service_role/secret key。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_FAMILY_SURNAME="刘"

# 可选：仅服务端使用的 Supabase HTTP(S) 地址；浏览器始终使用公开地址。
# 同源部署时必填，例如 http://gateway:8000。
SUPABASE_INTERNAL_URL=
APP_PORT=3000
GENEALOGY_IMAGE=onehacker/pure-genealogy:latest
